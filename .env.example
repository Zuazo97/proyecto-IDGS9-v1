# Copia este archivo como .env y llena los valores.
PORT=3000
NODE_ENV=development

# Cadena de conexión de MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/idgs9?retryWrites=true&w=majority

# Secreto para firmar los JWT de usuario. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_IN=8h
